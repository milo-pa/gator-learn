# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editors/IDE ---
.vscode/git

# IntelliJ IDEA - Files to ignore (user-specific, local configuration, caches)
.idea/workspace.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/modules.xml
.idea/csc648-fa25-03-team05.iml

# IntelliJ IDEA - Files to keep (do NOT ignore these)
# .idea/misc.xml
# .idea/vcs.xml
# .idea/encodings.xml
# .idea/checkstyle-idea.xml

# --- Java / Gradle / Build Artifacts ---
*.class
*.jar
*.war
build/
out/

# (Optional, Maven-style. Safe to keep even if you use Gradle)
target/

# --- Logs ---
logs/
*.log

# --- Spring Boot config & secrets ---
# Keep a safe default config in repo, ignore env-specific overrides
application-*.yml
application-*.properties
!application.yml
!application.properties.example

# Env files / secret dirs (never commit)
.env
.env.*
.envrc
secrets/
secrets/**

# --- SSL / keys / certs (never commit) ---
# *.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.csr
*.crt

# --- Node / Sass caches (for Dart Sass via npx) ---
node_modules/
.sass-cache/
dist/

# --- Database dumps (but keep Flyway migrations) ---
*.sql
dump*.sql