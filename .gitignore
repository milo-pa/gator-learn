# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editors/IDE ---
.vscode/
.idea/
*.iml

# --- Java / Gradle / Build Artifacts ---
*.class
*.jar
*.war
.gradle/
build/
out/
# Keep the Gradle wrapper JAR (needed in repo)
!gradle/wrapper/gradle-wrapper.jar

# (Optional, Maven-style. Safe to keep even if you use Gradle)
target/

# --- Logs ---
logs/
*.log

# --- Spring Boot config & secrets ---
# Keep a safe default config in repo, ignore env-specific overrides
application-*.yml
application-*.properties
!application.yml
!application.properties.example

# Env files / secret dirs (never commit)
.env
.env.*
.envrc
secrets/
secrets/**

# --- SSL / keys / certs (never commit) ---
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.csr
*.crt

# --- Node / Sass caches (for Dart Sass via npx) ---
node_modules/
.sass-cache/
dist/

# --- Database dumps (but keep Flyway migrations) ---
*.sql
dump*.sql